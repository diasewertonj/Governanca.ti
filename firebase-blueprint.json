{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil corporativo e papel de acesso do usuário",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID de autenticação Firebase Auth"
        },
        "email": {
          "type": "string",
          "description": "E-mail corporativo ou autenticado"
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição do usuário"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar do usuário"
        },
        "role": {
          "type": "string",
          "enum": ["ti_admin", "ti_suporte", "rh", "colaborador"],
          "description": "Papel de acesso no sistema corporativo"
        },
        "employeeId": {
          "type": "string",
          "description": "ID do colaborador vinculado na base"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Armazena o perfil e papel do usuário logado"
    }
  }
}
