# ==============================================================================
# Nexus IT & HR — variáveis de ambiente
# Copie para .env.local (nunca commite o .env.local) e preencha.
# Na Vercel: Settings > Environment Variables.
# ==============================================================================

# Supabase (Project Settings > API). Só a chave PÚBLICA (anon / publishable).
# NUNCA use a service_role aqui: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Sem estas duas variáveis, o `npm run dev` abre em modo demonstração
# (dados fictícios no navegador; login admin.ti@nexuscorp.com.br / nexus@2026).
# O build de produção não tem modo demonstração.
